# readmeops editor settings. For local development copy this file to .env.local (git-ignored).
# On Vercel, add the same names under Project Settings > Environment Variables.

# Needed to load real profiles: the server reads public GitHub data with it.
# Use a fine-grained personal access token with no permissions and no private repositories
# (every fine-grained token can read public repositories). If it can read your private
# repositories, looking up your own profile fails on purpose.
# Without it the editor still runs, showing a sample profile.
GITHUB_TOKEN=

# Everything below is optional. It turns on "Sign in to see private work", the owner-only view.
# Create your GitHub App with:
#   npm run setup:github-app -w @readmeops/editor -- --name readmeops-<your-login> --url https://<your-site>
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=

# 32 or more random characters. Encrypts the session cookie. Example: openssl rand -base64 48
SESSION_SECRET=

# The editor's own address, no trailing slash. GitHub sends people back here after sign-in.
APP_URL=http://localhost:3000

# Local development only (ignored in production): sign in with your own token instead of OAuth.
# READMEOPS_DEV_TOKEN=
